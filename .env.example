# Claudio - AI 情感电台

## 环境变量配置

复制此文件为 `.env` 并填入实际值：
```bash
cp .env.example .env
```

### 必填变量

# MiMo API Key
MIMO_API_KEY=

# MiMo API 地址
MIMO_API_BASE=https://api.xiaomimimo.com/v1

# MiMo TTS 模型
# 可选：mimo-v2.5-tts | mimo-v2.5-tts-voicedesign | mimo-v2.5-tts-voiceclone
MIMO_TTS_MODEL=mimo-v2.5-tts

# MiMo 默认音色（仅作为后端默认值；运行时可在前端切换）
MIMO_TTS_VOICE=冰糖

# VoiceClone 模式使用的音频样本路径（.wav 或 .mp3）
MIMO_TTS_VOICE_SAMPLE_PATH=

# 广播服务端口
PORT=3000

# 电台时区；用于后端给 AI DJ 的当前时间上下文，避免服务器 UTC 时区导致文案时间错误
CLAUDIO_TIME_ZONE=Asia/Hong_Kong

# LLM API Key（OpenAI-compatible）
LLM_API_KEY=

# LLM Base URL（例如 https://api.example.com/v1）
BASE_URL=

# LLM 模型名
MODEL=

# 多 LLM 配置（可选）
# LLM_PROVIDER_ORDER 留空时使用上面的 LLM_API_KEY / BASE_URL / MODEL 单 LLM 配置。
# 填入后按顺序 fallback；provider 名称只用于环境变量前缀和日志，不影响模型能力。
# 示例：LLM_PROVIDER_ORDER=primary,backup 表示先用 primary，失败或超时后再尝试 backup。
LLM_PROVIDER_ORDER=

LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://api.example.com/v1
LLM_PRIMARY_MODEL=
# 单个 provider 一次请求最多等待多久。
# 仅在 LLM_PROVIDER_ORDER 启用多 provider 时生效；实际等待不会超过当前 task 剩余总预算。
LLM_PRIMARY_TIMEOUT_MS=60000

LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=https://api.openai.com/v1
LLM_BACKUP_MODEL=gpt-4o-mini
# backup provider 一次请求最多等待多久。
# 如果 primary 已经消耗了部分 task 总预算，backup 最多只能使用剩余时间。
LLM_BACKUP_TIMEOUT_MS=60000

# LLM task 总超时（毫秒，可选）
# task timeout 控制一次具体 LLM 任务的总预算，不包含后续音乐搜索、播放 URL 解析或 TTS 时间。
# 多 provider fallback 时，task timeout 是 primary + backup 等所有 provider 尝试共用的总预算。
# 单 LLM 配置时，这些 task timeout 就是该任务单次 LLM 请求的超时。
#
# LLM_SEMANTIC_ROUTER_TIMEOUT_MS:
#   聊天意图语义路由。只用于判断模糊聊天是否要换歌/重编队列；失败会退回规则路由，建议保持较短。
LLM_SEMANTIC_ROUTER_TIMEOUT_MS=20000
#
# LLM_CHAT_SWITCH_TIMEOUT_MS:
#   用户在聊天里要求换风格、换氛围、换一组歌时，用来生成后续节目单；失败会使用关键词 fallback 队列。
LLM_CHAT_SWITCH_TIMEOUT_MS=90000
#
# LLM_STARTUP_TIMEOUT_MS:
#   启动节目、morning_brief、mood_pick 等完整节目规划；通常最重，建议比普通聊天换歌更长。
LLM_STARTUP_TIMEOUT_MS=120000
#
# LLM_DISCOVERY_TIMEOUT_MS:
#   Discovery Scout 生成探索方向；后端随后会用真实音源搜索并验证可播放，不让 LLM 直接决定最终播放链接。
LLM_DISCOVERY_TIMEOUT_MS=45000

### 可选变量

# 数据目录覆盖。
# 这里存放运行状态 state.json、TTS/audio 缓存、反馈、播放历史等本地数据，不应提交到 Git。
# 留空时：
#   正式运行用 repoRoot/data
#   测试环境用 repoRoot/data.test
# Windows 示例：D:\ClaudioData
# macOS/Linux 示例：/var/lib/claudio
# 相对路径示例：data.local
CLAUDIO_DATA_DIR=

# OpenWeather API Key（启用实时天气）
OPENWEATHER_API_KEY=

# 实时天气默认位置；服务启动时会按这里拉取一次，并缓存给 LLM 使用
# 二选一即可：
# 1) 填城市名 + 国家码，例如 Panyu,Guangzhou + CN
# 2) 直接填经纬度
OPENWEATHER_DEFAULT_CITY=
OPENWEATHER_DEFAULT_COUNTRY=
OPENWEATHER_DEFAULT_LAT=
OPENWEATHER_DEFAULT_LON=

# 天气接口默认单位（standard | metric | imperial）
OPENWEATHER_DEFAULT_UNITS=metric

# 天气文案语言
OPENWEATHER_DEFAULT_LANG=zh_cn

# 天气接口超时（毫秒）
OPENWEATHER_TIMEOUT_MS=8000

# 天气缓存刷新间隔（毫秒），默认 60 分钟
OPENWEATHER_REFRESH_MS=3600000

# 日志级别（debug | info | warn | error）
LOG_LEVEL=info

# 本地音乐库；配置目录后会优先用本地文件解析播放，多个目录用系统路径分隔符分开
# Windows 示例：D:\Music;E:\Radio
# macOS/Linux 示例：/Users/me/Music:/Volumes/Library
LOCAL_MUSIC_ENABLED=
LOCAL_MUSIC_DIRS=
LOCAL_MUSIC_SCAN_CACHE_MS=60000
LOCAL_MUSIC_MAX_FILES=2000

# YouTube 网络代理（可选）
# 只用于 YouTube API 和 googlevideo 播放链路；TTS、歌单同步等其它外部请求不会使用这里的代理。
# 留空时 YouTube 也默认直连；填写后 YouTube 请求会直接走代理，不再先直连。
# 本地如果需要代理访问 YouTube/googlevideo，填写代理地址；生产环境网络可直连时留空。
# 示例：NETWORK_PROXY_URL=http://127.0.0.1:7897
NETWORK_PROXY_URL=

# YouTube 音源（基于 youtubei.js，默认关闭）
# 启用后加入可播放搜索顺序（本地库 -> 酷狗 -> YouTube），QQ 音乐仅作为元数据 fallback
# 播放时前端只访问 /api/audio/youtube/{videoId}
# 解析出的 googlevideo 直链只保存在后端内存 stream lease 中，不写入 state.json，也不会下发前端
# YouTube 专用代理会透传 Range；遇到 403/过期/网络失败时会重新解析 stream 并重试
YOUTUBE_ENABLED=false
# YouTube stream lease 刷新间隔（毫秒），默认 30 分钟
YOUTUBE_URL_TTL_MS=1800000
# 可选：YouTube cookie（浏览器登录后从 cookie 中复制，降低匿名请求被拦截概率）
# 格式同浏览器 cookie 字符串，例如：SID=xx; HSID=xx; SSID=xx; APISID=xx; SAPISID=xx
YOUTUBE_COOKIE=
# 可选：BotGuard Proof of Origin Token，用于通过更严格的验证
YOUTUBE_PO_TOKEN=

# 网易云音乐 Cookie（用于歌单同步/导入，不用于播放）
# 仅当需要使用 /api/netease/sync 同步歌单快照时才需要
NETEASE_COOKIE=

# 酷狗音源（基于公开 API，默认开启）
# 搜索和播放链接均通过公开 HTTP 接口，无需 Cookie
KUGOU_ENABLED=true
# 播放 URL 刷新间隔（毫秒），默认 30 分钟
KUGOU_URL_TTL_MS=1800000

# QQ 音乐元数据 fallback（基于 @xnfa/qq-music-api，默认开启）
# 只用于 fallback 时获取更标准的歌曲信息；不参与播放 URL 解析
TENCENT_ENABLED=true
# 可选：QQ 音乐 Cookie（浏览器登录 y.qq.com 后从 cookie 中复制；当前 metadata-only，一般可不填）
# 格式示例：uin=xxx; qm_keyst=xxx; qqmusic_fromtag=xxx
TENCENT_COOKIE=
